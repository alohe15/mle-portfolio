# Test image. Extends the serving image (Compose build context "serving"
# = the fraud-api service) with pytest and the tests/ tree.
# data/ is not copied; docker-compose mounts it read-only at test time.
# Do not add these layers to Dockerfile — the production image stays lean.
FROM serving

COPY requirements-test.txt /tmp/requirements-test.txt
RUN pip install --no-cache-dir -r /tmp/requirements-test.txt \
    && rm /tmp/requirements-test.txt

# Parity reconstructs the temporal split from the serving model's config.
# That file is not part of the lean serving image.
COPY configs/lgbm_v9.json /app/configs/lgbm_v9.json
COPY tests/ /app/tests/

CMD ["python", "-m", "pytest", "tests/test_training_serving_parity.py", "tests/test_api_endpoint.py", "-v"]
